<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEON RUNNER ULTIMATE</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="game-wrapper">
        <div id="game-container">
            <div id="score">SCORE: 0</div>
            <div id="player"></div>
            <div class="ground"></div>
            <div id="overlay">
                <h1 id="title">NEON RUNNER<br>ULTIMATE</h1>
                <p>TAP or SPACE to JUMP<br>(Max 4 Steps)</p>
                <button id="start-btn">GAME START</button>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap');

:root {
  --theme-color: #00ffff; /* 初期カラー */
}

body {
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #050505;
  font-family: 'Orbitron', sans-serif;
  overflow: hidden;
  /* スマホでの誤操作防止（選択・ズーム無効化） */
  user-select: none;
  -webkit-user-select: none;
  touch-action: none; 
}

.game-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#game-container {
  width: 600px;
  height: 250px;
  background-color: #000;
  position: relative;
  overflow: hidden;
  border: 2px solid var(--theme-color);
  box-shadow: 0 0 20px var(--theme-color);
  transition: all 0.8s;
  /* グリッド背景 */
  background-image: 
    linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px), 
    linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 40px 40px;
  
  /* レスポンシブ縮小の基準点 */
  transform-origin: center;
}

/* --- レスポンシブ対応（画面が狭いときに縮小） --- */
@media (max-width: 620px) {
  #game-container { transform: scale(0.9); }
}
@media (max-width: 500px) {
  #game-container { transform: scale(0.75); }
}
@media (max-width: 400px) {
  #game-container { transform: scale(0.6); }
}

/* プレイヤー設定 */
#player {
  width: 35px; height: 35px;
  background-color: var(--theme-color);
  position: absolute; left: 50px;
  box-shadow: 0 0 15px var(--theme-color), 0 0 30px var(--theme-color);
  z-index: 3;
  /* 形や色の変化をアニメーション */
  transition: background-color 0.8s, box-shadow 0.8s, border-radius 0.2s, clip-path 0.2s, transform 0.2s, opacity 0.2s;
}

/* 無敵モード（点滅） */
#player.invincible {
  animation: blink 0.15s infinite alternate;
  opacity: 0.7;
}
@keyframes blink { from { opacity: 1; } to { opacity: 0.3; } }

/* 障害物スタイル */
.obstacle { position: absolute; z-index: 2; }
.obs-normal { width: 30px; height: 40px; background: #ff0055; clip-path: polygon(50% 0%, 100% 100%, 0% 100%); }
.obs-tall { width: 25px; height: 75px; background: #ffaa00; }
.obs-fly { width: 45px; height: 20px; background: #ffff00; }
.obs-wide { width: 60px; height: 25px; background: #aa00ff; }
.obs-double { width: 30px; height: 80px; background: #0055ff; clip-path: polygon(0% 0%, 100% 0%, 100% 45%, 50% 50%, 100% 55%, 100% 100%, 0% 100%, 0% 55%, 50% 50%, 0% 45%); }

/* コインアイテム */
.coin {
  width: 25px; height: 25px;
  background: #ffd700; border-radius: 50%;
  position: absolute; z-index: 1;
  box-shadow: 0 0 10px #ffd700, 0 0 20px #ffffff;
  animation: coinSpin 1s infinite linear;
}
@keyframes coinSpin { 0% { transform: rotateY(0deg); } 100% { transform: rotateY(360deg); } }

/* 地面・スコア・UI */
.ground {
  position: absolute; bottom: 0; width: 100%; height: 2px;
  background-color: var(--theme-color); box-shadow: 0 0 10px var(--theme-color);
  transition: background-color 0.8s;
}
#score {
  position: absolute; top: 15px; right: 20px;
  color: var(--theme-color); font-size: 24px; text-shadow: 0 0 10px var(--theme-color); z-index: 5;
  transition: color 0.8s;
}
#overlay {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0, 0, 0, 0.85); display: flex; flex-direction: column;
  justify-content: center; align-items: center; z-index: 10; backdrop-filter: blur(4px);
}
#title { font-size: 32px; color: var(--theme-color); margin-bottom: 10px; text-align: center; line-height: 1.2; }
#overlay p { color: #888; font-size: 14px; margin-bottom: 20px; text-align: center; line-height: 1.5; }
#start-btn {
  padding: 15px 40px; background: transparent; color: var(--theme-color);
  border: 2px solid var(--theme-color); cursor: pointer; font-family: 'Orbitron', sans-serif;
  font-size: 18px; touch-action: manipulation; transition: 0.3s;
}
#start-btn:hover, #start-btn:active { background: var(--theme-color); color: #000; box-shadow: 0 0 20px var(--theme-color); }
           const player = document.getElementById("player");
const gameContainer = document.getElementById("game-container");
const scoreElement = document.getElementById("score");
const overlay = document.getElementById("overlay");
const startBtn = document.getElementById("start-btn");

// ゲーム設定
let score = 0;
let isPlaying = false;
let obstacles = [];
let coins = [];
let spawnTimer = 0;
let coinSpawnTimer = 0;
let animationId;
let currentSpeed = 6;

// 無敵モード設定
let isInvincible = false;
let invincibleTimer = 0;
const INVINCIBLE_DURATION = 180; // 約3秒

// 物理演算設定
let playerY = 213;
let velocityY = 0;
const gravity = 0.6;
const jumpPower = -11;
const groundY = 213; 
let jumpCount = 0;
const maxJumps = 4;

// --- プレイヤーの変形ロジック ---
function updatePlayerShape() {
  switch(jumpCount) {
    case 0: // 地面：四角
      player.style.borderRadius="4px"; player.style.clipPath="none"; player.style.transform="rotate(0deg)"; break;
    case 1: // 1段：角丸＆45度
      player.style.borderRadius="12px"; player.style.clipPath="none"; player.style.transform="rotate(45deg)"; break;
    case 2: // 2段：円形＆90度
      player.style.borderRadius="50%"; player.style.clipPath="none"; player.style.transform="rotate(90deg)"; break;
    case 3: // 3段：ひし形＆135度
      player.style.borderRadius="0px"; player.style.clipPath="polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)"; player.style.transform="rotate(135deg)"; break;
    case 4: // 4段：三角形＆180度
      player.style.borderRadius="0px"; player.style.clipPath="polygon(50% 0%, 100% 100%, 0% 100%)"; player.style.transform="rotate(180deg)"; break;
  }
}

// --- ジャンプ処理（PC・スマホ共通） ---
function jump(e) {
  // イベントのデフォルト動作（スマホでのスクロール等）を防止
  if(e && e.cancelable) e.preventDefault();
  
  if (!isPlaying) return;
  
  if (jumpCount < maxJumps) {
    velocityY = jumpPower;
    jumpCount++;
    updatePlayerShape();
  }
}

// イベントリスナー登録
window.addEventListener("keydown", (e) => { if (e.code === "Space") jump(); });
gameContainer.addEventListener("mousedown", jump);
gameContainer.addEventListener("touchstart", jump, { passive: false });

// --- 背景色・テーマカラーの更新 ---
function updateEnvironment() {
  const root = document.querySelector(':root');
  if (score < 1500) root.style.setProperty('--theme-color', '#00ffff');      // Cyan
  else if (score < 3000) root.style.setProperty('--theme-color', '#ff00ff'); // Magenta
  else if (score < 5000) root.style.setProperty('--theme-color', '#00ff00'); // Green
  else if (score < 8000) root.style.setProperty('--theme-color', '#ff8800'); // Orange
  else root.style.setProperty('--theme-color', '#ffffff');                   // White (Max Level)
}

// --- 障害物生成 ---
function spawnObstacle() {
  const types = ["normal", "tall", "fly", "wide", "double"];
  const type = types[Math.floor(Math.random() * types.length)];
  const obs = document.createElement("div");
  obs.classList.add("obstacle", "obs-" + type);
  
  let w=30, h=40, b=0;
  if(type==="fly"){ w=45; h=20; b=90; }
  else if(type==="tall"){ w=25; h=75; }
  else if(type==="wide"){ w=60; h=25; }
  else if(type==="double"){ w=30; h=80; }
  
  const obsData = { element: obs, x: 600, width: w, height: h, bottom: b };
  obs.style.bottom = b + "px";
  gameContainer.appendChild(obs);
  obstacles.push(obsData);
}

// --- コイン生成 ---
function spawnCoin() {
  const coin = document.createElement("div");
  coin.classList.add("coin");
  const randomBottom = Math.floor(Math.random() * 120) + 40; 
  const coinData = { element: coin, x: 600, width: 25, height: 25, bottom: randomBottom };
  coin.style.bottom = randomBottom + "px";
  gameContainer.appendChild(coin);
  coins.push(coinData);
}

// --- 無敵発動 ---
function activateInvincibility() {
  isInvincible = true;
  invincibleTimer = INVINCIBLE_DURATION;
  player.classList.add("invincible");
}

// --- 当たり判定（矩形衝突） ---
function checkRectCollision(rect1, rect2) {
  return (
    rect1.left < rect2.right &&
    rect1.right > rect2.left &&
    rect1.top < rect2.bottom &&
    rect1.bottom > rect2.top
  );
}

// --- メインゲームループ ---
function update() {
  if (!isPlaying) return;

  // 1. 物理演算（重力）
  velocityY += gravity;
  playerY += velocityY;
  
  // 地面判定
  if (playerY >= groundY) {
    playerY = groundY; 
    velocityY = 0;
    if (jumpCount !== 0) { 
      jumpCount = 0; 
      updatePlayerShape(); // 着地で四角に戻る
    }
  }
  player.style.top = playerY + "px";

  // 2. スコア・環境更新
  score++;
  scoreElement.innerHTML = `SCORE: ${score}`;
  updateEnvironment();

  // 3. 難易度調整（スピードアップ＆生成頻度アップ）
  currentSpeed = 6 + (score / 600);
  const spawnInterval = Math.max(40, 100 - (score / 200));

  // 4. 生成タイマー処理
  spawnTimer++;
  if (spawnTimer > spawnInterval) { spawnObstacle(); spawnTimer = 0; }

  coinSpawnTimer++;
  if (coinSpawnTimer > 200) { spawnCoin(); coinSpawnTimer = 0; }

  // 5. 無敵タイマー処理
  if (isInvincible) {
    invincibleTimer--;
    if (invincibleTimer <= 0) {
      isInvincible = false;
      player.classList.remove("invincible");
    }
  }

  // プレイヤーの当たり判定ボックス
  const pRect = { left: 50, right: 85, top: playerY, bottom: playerY + 35 };

  // 6. コイン処理
  for (let i = coins.length - 1; i >= 0; i--) {
    let coin = coins[i];
    coin.x -= currentSpeed;
    coin.element.style.left = coin.x + "px";

    const cRect = { left: coin.x, right: coin.x + coin.width, top: 250 - coin.bottom - coin.height, bottom: 250 - coin.bottom };

    if (checkRectCollision(pRect, cRect)) {
      activateInvincibility(); // 無敵化
      coin.element.remove();
      coins.splice(i, 1);
      score += 100; // ボーナススコア
    } else if (coin.x < -30) {
      coin.element.remove(); coins.splice(i, 1);
    }
  }

  // 7. 障害物処理
  for (let i = obstacles.length - 1; i >= 0; i--) {
    let obs = obstacles[i];
    obs.x -= currentSpeed;
    obs.element.style.left = obs.x + "px";

    const oRect = { left: obs.x, right: obs.x + obs.width, top: 250 - obs.bottom - obs.height, bottom: 250 - obs.bottom };

    // 無敵でなければゲームオーバー判定
    if (!isInvincible && checkRectCollision(pRect, oRect)) {
      gameOver();
    }

    if (obs.x < -60) { obs.element.remove(); obstacles.splice(i, 1); }
  }

  animationId = requestAnimationFrame(update);
}

// --- ゲーム開始 ---
function startGame(e) {
  if(e && e.cancelable) e.preventDefault();
  
  score = 0; isPlaying = true; spawnTimer = 0; coinSpawnTimer = 0;
  velocityY = 0; playerY = groundY; jumpCount = 0; currentSpeed = 6;
  isInvincible = false; invincibleTimer = 0;
  
  updatePlayerShape(); 
  player.classList.remove("invincible");
  
  // 既存要素の削除
  obstacles.forEach(o => o.element.remove()); obstacles = [];
  coins.forEach(c => c.element.remove()); coins = [];
  
  overlay.style.display = "none";
  update();
}

// --- ゲームオーバー ---
function gameOver() {
  isPlaying = false; 
  cancelAnimationFrame(animationId);
  overlay.style.display = "flex";
  document.getElementById("title").innerHTML = "SYSTEM FAILURE";
  startBtn.innerHTML = "REBOOT";
}

// スタートボタン処理（PCクリック / スマホタッチ）
startBtn.addEventListener("click", startGame);
startBtn.addEventListener("touchstart", startGame, { passive: false });
